{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "artist": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480000
    },
    "audio": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^audio/song\\.(m4a|mp3|wav)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "charts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "chartId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "difficulty": {
            "enum": [
              "easy",
              "normal",
              "hard"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^charts/(easy|normal|hard)\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "chartId",
          "difficulty",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "beatTimesMs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 480000
      }
    },
    "downbeatIndices": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 480000
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "intro",
              "verse",
              "chorus",
              "bridge"
            ]
          },
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 480000
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 480000
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "startMs",
          "endMs",
          "confirmed"
        ],
        "additionalProperties": false
      }
    },
    "cover": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^art/cover\\.(png|jpg|webp)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "revision",
    "title",
    "artist",
    "durationMs",
    "audio",
    "charts",
    "beatTimesMs",
    "downbeatIndices",
    "sections"
  ],
  "additionalProperties": false
}