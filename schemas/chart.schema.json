{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "chartId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "difficulty": {
      "enum": [
        "easy",
        "normal",
        "hard"
      ]
    },
    "offsetMs": {
      "type": "integer",
      "minimum": -10000,
      "maximum": 10000
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "kind": {
                "const": "tap"
              },
              "timeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 480000
              },
              "color": {
                "enum": [
                  "don",
                  "ka"
                ]
              },
              "size": {
                "enum": [
                  "normal",
                  "large"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "timeMs",
              "color",
              "size"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "kind": {
                "const": "roll"
              },
              "timeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 480000
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 480000
              }
            },
            "required": [
              "id",
              "kind",
              "timeMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "chartId",
    "difficulty",
    "offsetMs",
    "notes"
  ],
  "additionalProperties": false
}